APP_NAME="LessonForge AI"
ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-characters

# 前后端服务端口与主机配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# 仅在 Gemini Interactions/Files 网关能力探测通过后开启。
GEMINI_INTERACTIONS_VIDEO_ENABLED=false

ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite+aiosqlite:////app/storage/app.db
STORAGE_ROOT=/app/storage
CORS_ORIGINS=http://localhost:8080
MAX_UPLOAD_MB=30
LLM_PROVIDER=mock
# Agent 交互门禁模式：relaxed（默认）移除意图确认/作用域/发布拦截等门禁，
# 交互修改按教师意图直接执行；strict 恢复全部历史门禁行为。
AGENT_GATES_MODE=relaxed
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
INITIAL_GENERATION_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=6000
DEFAULT_LANGUAGE=zh-CN
